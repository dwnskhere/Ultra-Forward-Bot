{
  "name": "Ultra Forward Bot",
  "description": "Telegram channel forwarding bot",
  "repository": "https://github.com/dwnskhere/Ultra-Forward-Bot",
  "success_url": "https://t.me/Madflix_Bots",
  "env": {
    "API_ID": {
      "description": "Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API hash from my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Bot token from @BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Owner Telegram user IDs, separated by spaces",
      "required": true
    },
    "BOT_SESSION": {
      "description": "Bot session name",
      "value": "forward-bot",
      "required": false
    },
    "DB_URL": {
      "description": "Persistent MongoDB connection URI",
      "required": true
    },
    "DB_NAME": {
      "description": "MongoDB database name",
      "value": "IND_BOTZ_FORWARD",
      "required": false
    }
  },
  "stack": "container",
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
